// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// User can be a buyer, a farmer, or both
model User {
  id        String    @id @default(uuid())
  email     String?    @unique
  phoneNumber String  @unique
  password  String
  name      String
  role      String[]  // Can be ["FARMER"], ["BUYER"], or ["FARMER", "BUYER"]
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[] // A user (as a farmer) can have many products
  orders   Order[]   // A user (as a buyer) can have many orders
  machinery Machinery[] // A user (as a farmer) can have many machinery
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  category    String   // e.g., "Vegetable", "Fruit", "Grains"
  imageUrl    String?
  stock       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmerId String
  farmer   User   @relation(fields: [farmerId], references: [id])

  orderItems OrderItem[]
}

// An order is placed by one buyer
model Order {
  id        String      @id @default(uuid())
  status    String      // e.g., "Pending", "Shipped", "Delivered"
  total     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyerId String
  buyer   User        @relation(fields: [buyerId], references: [id])
  items   OrderItem[]
}

// Connects products to an order
model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  price     Float    // Price at the time of purchase
  type      String   @default("product") // "product" or "rental"
  startDate DateTime?
  endDate   DateTime?
  duration  Int?     // hours or days
  pricingType String? // "hourly", "daily", "halfday"

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])
  machineryId String?
  machinery   Machinery? @relation(fields: [machineryId], references: [id])
}

model Machinery {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  pricingType String   // "hourly", "daily", "halfday"
  quantity    Int      @default(1)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmerId String
  farmer   User   @relation(fields: [farmerId], references: [id])

  orderItems OrderItem[]
}